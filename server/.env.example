# Copy this file to ".env" and fill in your key.

# --- FREE: Google Gemini (used by the paste-text feature) ---
# Get a free key (no credit card) at https://aistudio.google.com/apikey
# Use a project WITHOUT billing attached: once a project is on prepay billing
# with an empty balance it loses the free tier and every call returns 402.
GEMINI_API_KEY=your-google-ai-studio-key

# Optional: change the model if the default isn't available to you.
# Older models (gemini-2.5-flash/-lite) are closed to new API keys.
# GEMINI_MODEL=gemini-3.6-flash

# Optional: Google Search grounding. It finds live details like star ratings,
# but it is NOT in the free tier — with a free key every request that carries
# it fails, so it stays off unless you set this on a billed key.
# GEMINI_GROUNDING=1

# --- Instagram link reading via Apify (free monthly credit covers personal use) ---
# Get a token at https://console.apify.com/settings/integrations
# APIFY_TOKEN=apify_api_xxxx

# --- OPTIONAL (paid): Anthropic Claude, only for the screenshot feature ---
# ANTHROPIC_API_KEY=sk-ant-xxxx
# CLAUDE_MODEL=claude-haiku-4-5

# Optional: change the port (default 8787)
# PORT=8787
